{% doc %}
  @prompt
    Create a custom Shopify theme section that visually reproduces the store’s existing Featured article editorial layout as closely as possible, but without requiring a blog article. It should let the merchant choose an image, heading, body text, and optional link/button manually. Preserve the original layout’s proportions, typography hierarchy, spacing, image placement, alignment, and responsive behavior so it matches the existing Featured article section rather than the standard Image with text section. Make all content editable in the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% if block.settings.text_alignment == 'center' %}
  {% assign ai_gen_align = 'center' %}
{% else %}
  {% assign ai_gen_align = 'flex-start' %}
{% endif %}

{% style %}
  .ai-editorial-feature-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: {{ block.settings.margin_top }}px auto 0;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-feature__inner-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: minmax(0, {{ block.settings.image_width_percent }}fr) minmax(0, {{ 100 | minus: block.settings.image_width_percent }}fr);
    align-items: stretch;
    min-height: {{ block.settings.image_height }}px;
  }

  .ai-editorial-feature__media-{{ ai_gen_id }} {
    position: relative;
    min-height: {{ block.settings.image_height }}px;
    overflow: hidden;
    order: 1;
  }

  .ai-editorial-feature__media-{{ ai_gen_id }} img,
  .ai-editorial-feature__placeholder-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-feature__placeholder-{{ ai_gen_id }} {
    position: relative;
    background: {{ block.settings.placeholder_color }};
    color: {{ block.settings.muted_color }};
  }

  .ai-editorial-feature__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-editorial-feature__empty-{{ ai_gen_id }} {
    position: absolute;
    right: 24px;
    bottom: 20px;
    left: 24px;
    text-align: center;
    font-size: 12px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .ai-editorial-feature__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_alignment }};
    align-items: {{ ai_gen_align }};
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    order: 2;
  }

  .ai-editorial-feature__eyebrow-{{ ai_gen_id }} {
    margin: 0 0 18px;
    color: {{ block.settings.accent_color }};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-editorial-feature__heading-{{ ai_gen_id }} {
    max-width: 520px;
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 400;
    letter-spacing: .02em;
    line-height: 1.12;
  }

  .ai-editorial-feature__body-{{ ai_gen_id }} {
    max-width: 480px;
    margin: 24px 0 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.body_size }}px;
    line-height: 1.7;
  }

  .ai-editorial-feature__body-{{ ai_gen_id }} p {
    margin: 0 0 12px;
  }

  .ai-editorial-feature__body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-editorial-feature__actions-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ ai_gen_align }};
    gap: 16px;
    margin-top: 32px;
  }

  /* Filled primary CTA (inverted primary button colours) so it stands apart from the outlined secondary */
  .ai-editorial-feature__actions-{{ ai_gen_id }} .button.ai-editorial-feature__cta--primary-{{ ai_gen_id }} {
    --button-color: var(--color-primary-button-background);
    --button-border-color: var(--color-primary-button-text);
    background-color: var(--color-primary-button-text);
  }

  .ai-editorial-feature__actions-{{ ai_gen_id }} .button.ai-editorial-feature__cta--primary-{{ ai_gen_id }}:hover {
    background-color: var(--color-primary-button-hover-background);
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-feature-{{ ai_gen_id }} {
      margin-top: {{ block.settings.mobile_margin_top }}px;
    }

    .ai-editorial-feature__inner-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .ai-editorial-feature__media-{{ ai_gen_id }} {
      min-height: 0;
      aspect-ratio: 1 / 1;
      order: 1;
    }

    .ai-editorial-feature__content-{{ ai_gen_id }} {
      align-items: center;
      padding: {{ block.settings.mobile_content_padding }}px 24px;
      text-align: center;
      order: 2;
    }

    .ai-editorial-feature__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-editorial-feature__actions-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<div class="ai-editorial-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-feature__inner-{{ ai_gen_id }}">
    <div class="ai-editorial-feature__media-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-editorial-feature__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-editorial-feature__empty-{{ ai_gen_id }}">Add an editorial image</div>
        </div>
      {% endif %}
    </div>
    <div class="ai-editorial-feature__content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}<p class="ai-editorial-feature__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>{% endif %}
      {% if block.settings.heading != blank %}<h2 class="ai-editorial-feature__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>{% endif %}
      {% if block.settings.body != blank %}<div class="ai-editorial-feature__body-{{ ai_gen_id }}">{{ block.settings.body }}</div>{% endif %}
      {% assign ai_gen_show_primary = false %}
      {% assign ai_gen_show_secondary = false %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}{% assign ai_gen_show_primary = true %}{% endif %}
      {% if block.settings.secondary_button_label != blank and block.settings.secondary_button_link != blank %}{% assign ai_gen_show_secondary = true %}{% endif %}
      {% if ai_gen_show_primary or ai_gen_show_secondary %}
        <div class="ai-editorial-feature__actions-{{ ai_gen_id }}">
          {% if ai_gen_show_primary %}
            <a class="button ai-editorial-feature__cta--primary-{{ ai_gen_id }}" href="{{ block.settings.button_link }}">
              <span class="button-overflow relative overflow-hidden" data-button-text="{{ block.settings.button_label | escape }}">
                <span class="button-text-main inline-block relative z-1">{{ block.settings.button_label }}</span>
              </span>
            </a>
          {% endif %}
          {% if ai_gen_show_secondary %}
            <a class="button-secondary" href="{{ block.settings.secondary_button_link }}">
              <span class="button-overflow relative overflow-hidden" data-button-text="{{ block.settings.secondary_button_label | escape }}">
                <span class="button-text-main inline-block relative z-1">{{ block.settings.secondary_button_label }}</span>
              </span>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial feature",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A considered expression" },
    { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>Discover the details, craftsmanship and quiet beauty behind every piece.</p>" },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Our story" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "Shop collections" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link", "default": "/collections" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "image_width_percent", "label": "Image width", "min": 30, "max": 70, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "margin_top", "label": "Top margin", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "mobile_margin_top", "label": "Mobile top margin", "min": 0, "max": 96, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "image_height", "label": "Image height", "min": 300, "max": 900, "step": 10, "unit": "px", "default": 600 },
    { "type": "range", "id": "content_padding", "label": "Content spacing", "min": 24, "max": 120, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "mobile_content_padding", "label": "Mobile spacing", "min": 24, "max": 96, "step": 8, "unit": "px", "default": 48 },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "select", "id": "content_alignment", "label": "Content position", "options": [{ "value": "flex-start", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Bottom" }], "default": "center" },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_heading_size", "label": "Mobile heading size", "min": 24, "max": 52, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "body_size", "label": "Body size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1A1A1A" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#333333" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#6B5B4B" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder", "default": "#E8E5DE" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#555555" }
  ],
  "presets": [{ "name": "Editorial feature" }],
  "tag": null,
  "class": "editorial-feature-block"
}
{% endschema %}