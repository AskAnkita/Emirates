<script>
  (function() {
    class LuxuryMegaMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.trigger = this.querySelector('.ai-mega-menu-trigger-{{ ai_gen_id }}');
        this.panel = this.querySelector('.ai-mega-menu-panel-{{ ai_gen_id }}');
        
        if (this.trigger && this.panel) {
          this.setupEventListeners();
        }
      }

      setupEventListeners() {
        this.trigger.addEventListener('mouseenter', () => {
          this.panel.style.opacity = '1';
          this.panel.style.visibility = 'visible';
          this.panel.style.transform = 'translateY(0)';
        });

        this.trigger.addEventListener('mouseleave', () => {
          this.panel.style.opacity = '0';
          this.panel.style.visibility = 'hidden';
          this.panel.style.transform = 'translateY(-10px)';
        });
      }
    }

    customElements.define('luxury-mega-menu-{{ ai_gen_id }}', LuxuryMegaMenu{{ ai_gen_id }});
  })();
</script>

