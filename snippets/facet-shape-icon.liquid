{%- liquid
  assign shape_name = shape | strip | downcase
  assign shape_handle = shape | handle
-%}

<span class="facets__shape-icon facets__shape-icon--{{ shape_handle }}" aria-hidden="true">
  <svg viewBox="0 0 44 44" focusable="false" role="presentation">
    {%- case shape_name -%}
      {%- when 'oval' -%}
        <ellipse cx="22" cy="22" rx="11" ry="18"></ellipse>
        <path d="M22 4 14 22l8 18 8-18Z"></path>
        <path d="M11 22h22M16 10l12 24M28 10 16 34"></path>
      {%- when 'emerald' -%}
        <path d="M12 7h20l5 5v20l-5 5H12l-5-5V12Z"></path>
        <path d="M16 12h12l4 4v12l-4 4H16l-4-4V16Z"></path>
        <path d="M12 7l4 5M32 7l-4 5M37 12l-5 4M37 32l-5-4M32 37l-4-5M12 37l4-5M7 32l5-4M7 12l5 4"></path>
      {%- when 'round' -%}
        <circle cx="22" cy="22" r="17"></circle>
        <path d="M22 5v34M5 22h34M10 10l24 24M34 10 10 34"></path>
        <path d="M14 7l8 15 8-15M14 37l8-15 8 15"></path>
      {%- when 'pear' -%}
        <path d="M22 4c10 12 15 20 15 27 0 7-6 10-15 10S7 38 7 31C7 24 12 16 22 4Z"></path>
        <path d="M22 4v37M12 28h20M15 17l7 24 7-24"></path>
      {%- when 'asscher' -%}
        <path d="M13 6h18l7 7v18l-7 7H13l-7-7V13Z"></path>
        <path d="M16 12h12l4 4v12l-4 4H16l-4-4V16Z"></path>
        <path d="M13 6l3 6M31 6l-3 6M38 13l-6 3M38 31l-6-3M31 38l-3-6M13 38l3-6M6 31l6-3M6 13l6 3"></path>
      {%- when 'marquise' -%}
        <path d="M22 3C32 11 37 17 37 22s-5 11-15 19C12 33 7 27 7 22S12 11 22 3Z"></path>
        <path d="M22 3v38M7 22h30M14 10l16 24M30 10 14 34"></path>
      {%- when 'radiant' -%}
        <path d="M13 6h18l7 7v18l-7 7H13l-7-7V13Z"></path>
        <path d="M13 6 22 22l9-16M6 13l16 9-16 9M13 38l9-16 9 16M38 13l-16 9 16 9"></path>
        <path d="M13 13h18v18H13Z"></path>
      {%- when 'cushion' -%}
        <path d="M14 7h16c5 0 7 2 7 7v16c0 5-2 7-7 7H14c-5 0-7-2-7-7V14c0-5 2-7 7-7Z"></path>
        <path d="M14 12h16l2 2v16l-2 2H14l-2-2V14Z"></path>
        <path d="M12 14 22 22l10-8M12 30l10-8 10 8M22 7v30"></path>
      {%- when 'princess' -%}
        <path d="M8 8h28v28H8Z"></path>
        <path d="M8 8 22 22 36 8M8 36l14-14 14 14M8 8l28 28M36 8 8 36"></path>
      {%- when 'heart' -%}
        <path d="M22 38C12 29 6 23 6 15c0-5 4-9 9-9 3 0 6 2 7 5 1-3 4-5 7-5 5 0 9 4 9 9 0 8-6 14-16 23Z"></path>
        <path d="M22 11v27M10 18h24M12 25l10-14 10 14"></path>
      {%- else -%}
        <circle cx="22" cy="22" r="17"></circle>
        <path d="M22 5v34M5 22h34M10 10l24 24M34 10 10 34"></path>
    {%- endcase -%}
  </svg>
</span>
