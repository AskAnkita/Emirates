    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "buttons_spacing",
      "label": "Buttons spacing",
      "min": 0,
      "max": 50,
      "step": 2,
